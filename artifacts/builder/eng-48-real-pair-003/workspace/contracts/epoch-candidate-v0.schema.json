{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/contracts/epoch-candidate-v0.schema.json",
  "title": "LogicLens epoch candidate proposal v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "taskId",
    "base",
    "provider",
    "uiContractVersion",
    "cliProtocolVersion",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "revision"
      ],
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "model"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fixture",
            "ollama",
            "codex",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "uiContractVersion": {
      "const": "0.1"
    },
    "cliProtocolVersion": {
      "const": "0.1"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cliCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "manualFixes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "kind": {
            "enum": [
              "rule",
              "test",
              "ui"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 10000
    }
  }
}
