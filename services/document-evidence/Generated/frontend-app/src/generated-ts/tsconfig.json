{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "runtime/**/*.ts",
    "shared/**/*.ts",
    "shared/**/*.json",
    "meta/**/*.ts",
    "operations/**/*.ts",
    "operations/**/*.json",
    "documentfragments/types/**/*.ts",
    "documentrevisions/types/**/*.ts",
    "documents/types/**/*.ts",
    "permissions/types/**/*.ts",
    "processingjobs/types/**/*.ts",
    "rolepermissions/types/**/*.ts",
    "roles/types/**/*.ts",
    "staffpositionassignments/types/**/*.ts",
    "staffpositionroles/types/**/*.ts",
    "staffpositions/types/**/*.ts",
    "storedobjects/types/**/*.ts",
    "documentfragments/components/**/*.tsx",
    "documentrevisions/components/**/*.tsx",
    "documents/components/**/*.tsx",
    "permissions/components/**/*.tsx",
    "processingjobs/components/**/*.tsx",
    "rolepermissions/components/**/*.tsx",
    "roles/components/**/*.tsx",
    "staffpositionassignments/components/**/*.tsx",
    "staffpositionroles/components/**/*.tsx",
    "staffpositions/components/**/*.tsx",
    "storedobjects/components/**/*.tsx",
    "documentfragments/pages/**/*.tsx",
    "documentrevisions/pages/**/*.tsx",
    "documents/pages/**/*.tsx",
    "permissions/pages/**/*.tsx",
    "processingjobs/pages/**/*.tsx",
    "rolepermissions/pages/**/*.tsx",
    "roles/pages/**/*.tsx",
    "staffpositionassignments/pages/**/*.tsx",
    "staffpositionroles/pages/**/*.tsx",
    "staffpositions/pages/**/*.tsx",
    "storedobjects/pages/**/*.tsx",
    "documentfragments/realtime/**/*.ts",
    "documentrevisions/realtime/**/*.ts",
    "documents/realtime/**/*.ts",
    "permissions/realtime/**/*.ts",
    "processingjobs/realtime/**/*.ts",
    "rolepermissions/realtime/**/*.ts",
    "roles/realtime/**/*.ts",
    "staffpositionassignments/realtime/**/*.ts",
    "staffpositionroles/realtime/**/*.ts",
    "staffpositions/realtime/**/*.ts",
    "storedobjects/realtime/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
