{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/contracts/activation-transaction-attestation-v0.schema.json",
  "title": "LogicLens activation transaction attestation v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "transactionId",
    "outcome",
    "decisionHash",
    "beforePointer",
    "afterPointer",
    "targetPackageHash",
    "rollbackPackageHash",
    "checks",
    "failure",
    "journalHash",
    "intent",
    "transactionHash"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "stage": { "const": "activation-transaction-attestation" },
    "transactionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "outcome": { "enum": ["committed", "rolled-back"] },
    "decisionHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "beforePointer": { "$ref": "#/$defs/pointer" },
    "afterPointer": { "$ref": "#/$defs/pointer" },
    "targetPackageHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rollbackPackageHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionReverified",
        "currentMatched",
        "targetInstalled",
        "preSwitchRuntimePassed",
        "pointerSwapped",
        "postSwitchRuntimePassed",
        "rollbackPerformed",
        "rollbackRuntimePassed",
        "journalFinalized"
      ],
      "properties": {
        "decisionReverified": { "type": "boolean" },
        "currentMatched": { "type": "boolean" },
        "targetInstalled": { "type": "boolean" },
        "preSwitchRuntimePassed": { "type": "boolean" },
        "pointerSwapped": { "type": "boolean" },
        "postSwitchRuntimePassed": { "type": "boolean" },
        "rollbackPerformed": { "type": "boolean" },
        "rollbackRuntimePassed": { "type": "boolean" },
        "journalFinalized": { "type": "boolean" }
      }
    },
    "failure": { "type": ["string", "null"] },
    "journalHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apply", "activePointerUpdate", "recovery"],
      "properties": {
        "apply": { "enum": ["performed", "rolled-back", "not-performed"] },
        "activePointerUpdate": { "enum": ["performed", "restored", "not-performed"] },
        "recovery": { "enum": ["not-required", "performed"] }
      }
    },
    "transactionHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stage",
        "generation",
        "epoch",
        "revision",
        "packageHash",
        "packagePath",
        "decisionHash",
        "transactionId",
        "pointerHash"
      ],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "stage": { "const": "active-pointer" },
        "generation": { "type": "integer", "minimum": 0 },
        "epoch": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 },
        "packageHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "packagePath": { "type": "string", "pattern": "^packages/[A-Za-z0-9][A-Za-z0-9._-]{0,191}$" },
        "decisionHash": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          ]
        },
        "transactionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "pointerHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
