{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/contracts/capsule-query-v0.schema.json",
  "title": "LogicLens capsule query v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "target"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "operation": {"const": "strict-claim"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "arguments"],
      "properties": {
        "predicate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": ["string", "integer", "boolean"]}
        }
      }
    }
  }
}
