{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/contracts/builder-task-v0.schema.json",
  "title": "LogicLens Builder task v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "title",
    "base",
    "contracts",
    "objective",
    "candidate",
    "evidenceRequests",
    "acceptance"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "revision"],
      "properties": {
        "epoch": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "cli", "ui"],
      "properties": {
        "candidate": { "const": "0.1" },
        "cli": { "const": "0.1" },
        "ui": { "const": "0.1" }
      }
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulePath",
        "testPath",
        "uiPath",
        "module",
        "predicate",
        "arity",
        "uiPredicate",
        "uiComponent"
      ],
      "properties": {
        "rulePath": { "pattern": "^rules/candidate_[A-Za-z0-9_]+\\.pl$" },
        "testPath": { "pattern": "^tests/candidate_[A-Za-z0-9_]+_tests\\.pl$" },
        "uiPath": { "pattern": "^ui/[A-Za-z0-9._-]+\\.json$" },
        "module": { "pattern": "^[a-z][a-z0-9_]*$" },
        "predicate": { "pattern": "^[a-z][a-z0-9_]*$" },
        "arity": { "const": 2 },
        "uiPredicate": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "uiComponent": {
          "enum": ["Property", "TextBlock", "RawProlog", "Diagnostic"]
        }
      }
    },
    "evidenceRequests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "options"],
        "properties": {
          "name": { "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "command": { "enum": ["inspect-facts", "entity-view", "subgraph"] },
          "options": { "type": "object" }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}
