{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/contracts/source-proposal-activation-record-v0.schema.json",
  "title": "LogicLens source proposal activation record v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "activationId",
    "status",
    "proposalId",
    "packageHash",
    "worldId",
    "capsuleId",
    "sourceId",
    "reviewClass",
    "approvalMode",
    "oldCapsuleVersion",
    "newCapsuleVersion",
    "assertionIds",
    "modules",
    "activationHash"
  ],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "activationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
    },
    "status": {"enum": ["staged", "activated"]},
    "proposalId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "packageHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "worldId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "capsuleId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "reviewClass": {
      "enum": ["human-reviewed", "provisional"]
    },
    "approvalMode": {
      "enum": ["human-reviewed", "provisional-override"]
    },
    "oldCapsuleVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "newCapsuleVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "assertionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moduleId", "oldVersion", "newVersion"],
        "properties": {
          "moduleId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "oldVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "newVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    },
    "activationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
