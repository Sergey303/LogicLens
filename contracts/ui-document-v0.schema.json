{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/contracts/ui-document-v0.schema.json",
  "title": "LogicLens UI Document v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "epoch", "revision", "page", "diagnostics"],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "page": {
      "$ref": "#/$defs/page"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "maxItems": 100
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "componentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "title", "sections"],
      "properties": {
        "kind": {
          "const": "page"
        },
        "id": {
          "$ref": "#/$defs/componentId"
        },
        "title": {
          "type": "string",
          "maxLength": 2048
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          },
          "maxItems": 200
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "title", "presentation", "components"],
      "properties": {
        "kind": {
          "const": "section"
        },
        "id": {
          "$ref": "#/$defs/componentId"
        },
        "title": {
          "type": "string",
          "maxLength": 2048
        },
        "presentation": {
          "enum": ["default", "collapsed", "technical"]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          },
          "maxItems": 1000
        }
      }
    },
    "component": {
      "oneOf": [
        {
          "$ref": "#/$defs/property"
        },
        {
          "$ref": "#/$defs/textBlock"
        },
        {
          "$ref": "#/$defs/rawProlog"
        },
        {
          "$ref": "#/$defs/diagnostic"
        }
      ]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "predicate", "label", "direction", "values"],
      "properties": {
        "kind": {
          "const": "property"
        },
        "id": {
          "$ref": "#/$defs/componentId"
        },
        "predicate": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "maxLength": 2048
        },
        "direction": {
          "enum": ["outgoing", "incoming", "derived"]
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/textValue"
        },
        {
          "$ref": "#/$defs/resourceLinkValue"
        }
      ]
    },
    "textValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "language", "datatype", "editable", "source"],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "language": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "datatype": {
          "type": ["string", "null"],
          "maxLength": 1024
        },
        "editable": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "resourceLinkValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetId", "label", "editable", "source"],
      "properties": {
        "kind": {
          "const": "resourceLink"
        },
        "targetId": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "maxLength": 2048
        },
        "editable": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/baseSource"
        },
        {
          "$ref": "#/$defs/derivedSource"
        }
      ]
    },
    "baseSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "factId", "origins"],
      "properties": {
        "kind": {
          "const": "base"
        },
        "factId": {
          "$ref": "#/$defs/identifier"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true,
          "maxItems": 1000
        }
      }
    },
    "derivedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ruleId", "evidenceFactIds"],
      "properties": {
        "kind": {
          "const": "derived"
        },
        "ruleId": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceFactIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true,
          "maxItems": 10000
        }
      }
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "text"],
      "properties": {
        "kind": {
          "const": "textBlock"
        },
        "id": {
          "$ref": "#/$defs/componentId"
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "rawProlog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "title", "code", "artifactKind"],
      "properties": {
        "kind": {
          "const": "rawProlog"
        },
        "id": {
          "$ref": "#/$defs/componentId"
        },
        "title": {
          "type": "string",
          "maxLength": 2048
        },
        "code": {
          "type": "string",
          "maxLength": 500000
        },
        "artifactKind": {
          "enum": ["query", "data", "view", "rule", "diagnostic"]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "severity", "message"],
      "properties": {
        "kind": {
          "const": "diagnostic"
        },
        "id": {
          "$ref": "#/$defs/componentId"
        },
        "severity": {
          "enum": ["info", "warning", "error"]
        },
        "message": {
          "type": "string",
          "maxLength": 10000
        }
      }
    }
  }
}