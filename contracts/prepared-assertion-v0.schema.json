{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/contracts/prepared-assertion-v0.schema.json",
  "title": "LogicLens prepared assertion v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assertionId",
    "target",
    "stance",
    "provenance",
    "dependencyGroup",
    "generalisability"
  ],
  "properties": {
    "assertionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate", "arguments"],
      "properties": {
        "predicate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": ["string", "integer", "boolean"]
          }
        }
      }
    },
    "stance": {
      "enum": ["support", "oppose"]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "dependencyGroup": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "scope": {
      "type": "object"
    },
    "generalisability": {
      "enum": ["universal", "context-dependent", "local"]
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
