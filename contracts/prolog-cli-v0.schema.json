{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/contracts/prolog-cli-v0.schema.json",
  "title": "LogicLens Prolog CLI v0",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxDepth": { "type": "integer", "minimum": 0 },
        "maxNodes": { "type": "integer", "minimum": 1 },
        "maxFacts": { "type": "integer", "minimum": 1 },
        "maxOccurrences": { "type": "integer", "minimum": 1 },
        "maxOutputBytes": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "requestId", "command", "epoch", "revision", "options"],
      "properties": {
        "protocolVersion": { "const": "0.1" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "command": {
          "enum": ["health", "inspect-facts", "entity-view", "subgraph"]
        },
        "epoch": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 },
        "options": {
          "oneOf": [
            { "$ref": "#/$defs/healthOptions" },
            { "$ref": "#/$defs/entityOptions" },
            { "$ref": "#/$defs/subgraphOptions" }
          ]
        }
      }
    },
    "healthOptions": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "entityOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId"],
      "properties": {
        "entityId": { "$ref": "#/$defs/identifier" },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "includeRawProlog": { "type": "boolean" },
        "limits": { "$ref": "#/$defs/limits" }
      }
    },
    "subgraphOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootId", "depth", "direction"],
      "properties": {
        "rootId": { "$ref": "#/$defs/identifier" },
        "depth": { "type": "integer", "minimum": 0 },
        "direction": { "enum": ["outgoing", "incoming", "both"] },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "limits": { "$ref": "#/$defs/limits" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": {
          "type": "string",
          "maxLength": 10000
        },
        "context": {
          "type": "object"
        }
      }
    },
    "responseBase": {
      "type": "object",
      "properties": {
        "protocolVersion": { "const": "0.1" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "epoch": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" },
          "maxItems": 1000
        }
      },
      "required": ["protocolVersion", "requestId", "epoch", "revision", "diagnostics"]
    },
    "successResponse": {
      "allOf": [
        { "$ref": "#/$defs/responseBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "requestId", "status", "epoch", "revision", "result", "diagnostics"],
          "properties": {
            "protocolVersion": { "const": "0.1" },
            "requestId": { "$ref": "#/$defs/requestId" },
            "status": { "const": "ok" },
            "epoch": { "type": "integer", "minimum": 0 },
            "revision": { "type": "integer", "minimum": 0 },
            "result": {},
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "#/$defs/diagnostic" },
              "maxItems": 1000
            }
          }
        }
      ]
    },
    "errorResponse": {
      "allOf": [
        { "$ref": "#/$defs/responseBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocolVersion", "requestId", "status", "epoch", "revision", "error", "diagnostics"],
          "properties": {
            "protocolVersion": { "const": "0.1" },
            "requestId": { "$ref": "#/$defs/requestId" },
            "status": { "const": "error" },
            "epoch": { "type": "integer", "minimum": 0 },
            "revision": { "type": "integer", "minimum": 0 },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "message": {
                  "type": "string",
                  "maxLength": 10000
                },
                "details": { "type": "object" }
              }
            },
            "diagnostics": {
              "type": "array",
              "items": { "$ref": "#/$defs/diagnostic" },
              "maxItems": 1000
            }
          }
        }
      ]
    }
  }
}
