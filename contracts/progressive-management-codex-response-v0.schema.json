{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "answer",
    "epistemicStatus",
    "action",
    "conclusionStrength",
    "abstain",
    "usedVerifiedFrame",
    "evidenceIds",
    "proofNodeIds",
    "warnings",
    "scopeStatement"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "answer": {
      "type": "string"
    },
    "epistemicStatus": {
      "type": "string",
      "enum": [
        "supported",
        "refuted",
        "unknown",
        "conflicting"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "answer_with_source_scope",
        "explain_explicit_role_boundary",
        "abstain_and_request_context",
        "report_conflict_and_compare_models"
      ]
    },
    "conclusionStrength": {
      "type": "string",
      "enum": [
        "assert",
        "qualified",
        "abstain",
        "report_conflict"
      ]
    },
    "abstain": {
      "type": "boolean"
    },
    "usedVerifiedFrame": {
      "type": "boolean"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proofNodeIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scopeStatement": {
      "type": "string"
    }
  }
}
