{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/eng202/teacher-generation-ledger.schema.json",
  "title": "ENG-202 Codex teacher generation ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "runtime", "budget", "records", "summary"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "corpus_id": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex_cli_version", "executable_sha256", "resolved_provider", "resolved_model", "teacher_model_reproducibility", "instruction_sha256", "template_sha256"],
      "properties": {
        "codex_cli_version": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "resolved_provider": {"type": ["string", "null"]},
        "resolved_model": {"type": ["string", "null"]},
        "teacher_model_reproducibility": {"enum": ["exact", "limited"]},
        "instruction_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_successful_semantic_responses_per_record", "max_provider_attempts_per_record", "max_input_tokens_per_attempt", "max_output_tokens_per_semantic_response"],
      "properties": {
        "max_successful_semantic_responses_per_record": {"const": 1},
        "max_provider_attempts_per_record": {"const": 2},
        "max_input_tokens_per_attempt": {"const": 4096},
        "max_output_tokens_per_semantic_response": {"const": 256}
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_hash", "attempts", "final_status", "accepted_response_sha256", "successful_semantic_responses"],
        "properties": {
          "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "attempts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["attempt_index", "request_sha256", "status", "response_sha256", "input_tokens", "output_tokens", "schema_valid", "semantic_response_produced", "started_at_utc", "ended_at_utc"],
              "properties": {
                "attempt_index": {"enum": [1, 2]},
                "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "status": {"enum": ["success", "transport_failure", "provider_failure", "refusal", "schema_failure", "budget_failure"]},
                "response_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 4096},
                "output_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 256},
                "schema_valid": {"type": "boolean"},
                "semantic_response_produced": {"type": "boolean"},
                "started_at_utc": {"type": "string", "format": "date-time"},
                "ended_at_utc": {"type": "string", "format": "date-time"}
              }
            }
          },
          "final_status": {"enum": ["success", "transport_failure", "provider_failure", "refusal", "schema_failure", "budget_failure"]},
          "accepted_response_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "successful_semantic_responses": {"type": "integer", "minimum": 0, "maximum": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_train", "successes", "failed_records", "provider_attempts", "observed_input_tokens", "observed_output_tokens", "model_identity_stable", "outcome_directed_regeneration"],
      "properties": {
        "n_train": {"type": "integer", "minimum": 1},
        "successes": {"type": "integer", "minimum": 0},
        "failed_records": {"type": "integer", "minimum": 0},
        "provider_attempts": {"type": "integer", "minimum": 1},
        "observed_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "observed_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "model_identity_stable": {"type": "boolean"},
        "outcome_directed_regeneration": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"runtime": {"properties": {"resolved_model": {"type": "null"}}}}},
      "then": {"properties": {"runtime": {"properties": {"teacher_model_reproducibility": {"const": "limited"}}}}}
    },
    {
      "if": {"properties": {"runtime": {"properties": {"teacher_model_reproducibility": {"const": "exact"}}}}},
      "then": {"properties": {"runtime": {"properties": {"resolved_provider": {"type": "string", "minLength": 1}, "resolved_model": {"type": "string", "minLength": 1}}}}}
    }
  ]
}
