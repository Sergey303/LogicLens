{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/epistemic-compiler-lab/claim-evidence-row.schema.json",
  "title": "Claim–evidence matrix for Compile, Don’t Teach",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_package_id",
    "central_claim",
    "primary_design",
    "abstract_sentence_order",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_package_id": {
      "const": "WP-002"
    },
    "central_claim": {
      "type": "string",
      "minLength": 30
    },
    "primary_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrast_id",
        "treatment",
        "baseline_selection_rule",
        "endpoint",
        "unit_of_analysis",
        "confirmatory_sources"
      ],
      "properties": {
        "contrast_id": {
          "const": "PRIMARY-COMPILED-VS-STRONGEST-MATCHED"
        },
        "treatment": {
          "const": "M6_COMPILED_VERIFIED_FRAME"
        },
        "baseline_selection_rule": {
          "type": "string",
          "minLength": 20
        },
        "endpoint": {
          "const": "scenario_level_exact_epistemic_contract_accuracy"
        },
        "unit_of_analysis": {
          "const": "base_scenario_id"
        },
        "confirmatory_sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "frozen_holdout",
              "independent_replication"
            ]
          }
        }
      }
    },
    "abstract_sentence_order": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "ABS-01"
        },
        {
          "const": "ABS-02"
        },
        {
          "const": "ABS-03"
        },
        {
          "const": "ABS-04"
        },
        {
          "const": "ABS-05"
        },
        {
          "const": "ABS-06"
        },
        {
          "const": "ABS-07"
        }
      ],
      "items": false
    },
    "rows": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": false,
      "items": {
        "$ref": "#/$defs/claimRow"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "claim_class": {
                "const": "primary"
              }
            },
            "required": [
              "claim_class"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "abstract_sentence_id": {
                "const": "ABS-01"
              }
            },
            "required": [
              "abstract_sentence_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "abstract_sentence_id": {
                "const": "ABS-02"
              }
            },
            "required": [
              "abstract_sentence_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "abstract_sentence_id": {
                "const": "ABS-03"
              }
            },
            "required": [
              "abstract_sentence_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "abstract_sentence_id": {
                "const": "ABS-04"
              }
            },
            "required": [
              "abstract_sentence_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "abstract_sentence_id": {
                "const": "ABS-05"
              }
            },
            "required": [
              "abstract_sentence_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "abstract_sentence_id": {
                "const": "ABS-06"
              }
            },
            "required": [
              "abstract_sentence_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "abstract_sentence_id": {
                "const": "ABS-07"
              }
            },
            "required": [
              "abstract_sentence_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "claimRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "abstract_sentence_id",
        "claim_class",
        "hypothesis_links",
        "status",
        "abstract_inclusion",
        "claim_text",
        "allowed_wording",
        "prohibited_expansions",
        "estimand",
        "treatment",
        "comparator",
        "unit_of_analysis",
        "primary_metric",
        "secondary_metrics",
        "required_controls",
        "strongest_alternative_explanation",
        "confirmatory_evidence",
        "planning_evidence",
        "target_table",
        "failure_wording",
        "retain_rule",
        "narrow_rule",
        "delete_rule"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^CLM-[0-9]{3}$"
        },
        "abstract_sentence_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ABS-[0-9]{2}$"
        },
        "claim_class": {
          "enum": [
            "primary",
            "secondary",
            "technical",
            "interpretive",
            "future_work"
          ]
        },
        "hypothesis_links": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "H1",
              "H2",
              "H3",
              "H4",
              "H5",
              "H6",
              "T_SCOPE",
              "T_INDEPENDENCE",
              "T_FREEZE",
              "T_PRIVACY",
              "T_COPYING",
              "T_SOLVER_CONTROL"
            ]
          }
        },
        "status": {
          "enum": [
            "preregistered",
            "conditional",
            "future_work",
            "deleted"
          ]
        },
        "abstract_inclusion": {
          "type": "boolean"
        },
        "claim_text": {
          "type": "string",
          "minLength": 20
        },
        "allowed_wording": {
          "type": "string",
          "minLength": 20
        },
        "prohibited_expansions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "estimand": {
          "type": "string",
          "minLength": 10
        },
        "treatment": {
          "type": "string",
          "minLength": 2
        },
        "comparator": {
          "type": "string",
          "minLength": 2
        },
        "unit_of_analysis": {
          "type": "string",
          "minLength": 3
        },
        "primary_metric": {
          "type": "string",
          "minLength": 3
        },
        "secondary_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "strongest_alternative_explanation": {
          "type": "string",
          "minLength": 15
        },
        "confirmatory_evidence": {
          "type": "array",
          "items": {
            "enum": [
              "frozen_holdout",
              "independent_replication",
              "frozen_ablation",
              "frozen_layer_audit",
              "artifact_hash_audit",
              "public_surrogate_privacy_study"
            ]
          }
        },
        "planning_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_table": {
          "type": "string",
          "pattern": "^(T|S|F)[0-9]+([A-Z])?$"
        },
        "failure_wording": {
          "type": "string",
          "minLength": 15
        },
        "retain_rule": {
          "type": "string",
          "minLength": 15
        },
        "narrow_rule": {
          "type": "string",
          "minLength": 15
        },
        "delete_rule": {
          "type": "string",
          "minLength": 15
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_class": {
                "const": "primary"
              }
            },
            "required": [
              "claim_class"
            ]
          },
          "then": {
            "properties": {
              "claim_id": {
                "const": "CLM-003"
              },
              "abstract_sentence_id": {
                "const": "ABS-03"
              },
              "confirmatory_evidence": {
                "contains": {
                  "const": "frozen_holdout"
                },
                "minContains": 1
              },
              "status": {
                "const": "preregistered"
              },
              "abstract_inclusion": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "future_work",
                  "deleted"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "abstract_inclusion": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "abstract_inclusion": {
                "const": true
              }
            },
            "required": [
              "abstract_inclusion"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "preregistered",
                  "conditional"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_id": {
                "const": "CLM-010"
              }
            },
            "required": [
              "claim_id"
            ]
          },
          "then": {
            "properties": {
              "claim_class": {
                "const": "future_work"
              },
              "status": {
                "const": "future_work"
              },
              "abstract_inclusion": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
