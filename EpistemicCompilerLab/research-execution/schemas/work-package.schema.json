{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/epistemic-compiler-lab/work-package.schema.json",
  "title": "Compile, Don't Teach executable work-package DAG",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program",
    "hypotheses",
    "threats",
    "roles",
    "change_control",
    "graph",
    "nodes",
    "optional"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "area",
        "linear_project",
        "snapshot",
        "claim_boundary",
        "non_claims"
      ],
      "properties": {
        "repository": {
          "const": "Sergey303/LogicLens"
        },
        "branch": {
          "const": "main"
        },
        "area": {
          "const": "EpistemicCompilerLab/"
        },
        "linear_project": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "format": "date"
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 40
        },
        "non_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hypotheses": {
      "type": "object",
      "required": [
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^H[1-6]$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "threats": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 3,
      "patternProperties": {
        "^R\\d{2}$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "change_control": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roots",
        "terminal",
        "gates",
        "edge"
      ],
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "terminal": {
          "$ref": "#/$defs/nodeId"
        },
        "gates": {
          "type": "array",
          "const": [
            "GATE-001",
            "GATE-101",
            "GATE-201",
            "GATE-301",
            "GATE-401"
          ]
        },
        "edge": {
          "const": "dependency -> dependent"
        }
      }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^(WP|GATE)-\\d{3}$": {
          "$ref": "#/$defs/node"
        }
      },
      "additionalProperties": false
    },
    "optional": {
      "type": "object",
      "patternProperties": {
        "^ROB-\\d{3}$": {
          "$ref": "#/$defs/optional"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^(WP|GATE)-\\d{3}$"
    },
    "strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roleId": {
      "type": "string",
      "pattern": "^R\\d{2}$"
    },
    "link": {
      "type": "string",
      "pattern": "^(H[1-6]|T_[A-Z]+)$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "phase",
        "kind",
        "title",
        "deps",
        "producer",
        "reviewer",
        "gatekeeper",
        "gate",
        "inputs",
        "outputs",
        "acceptance",
        "stop",
        "links"
      ],
      "properties": {
        "issue": {
          "type": "string",
          "pattern": "^ENG-\\d+$"
        },
        "phase": {
          "enum": [
            "W0",
            "W1",
            "W2",
            "W3",
            "W4"
          ]
        },
        "kind": {
          "enum": [
            "work",
            "gate"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "deps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "producer": {
          "$ref": "#/$defs/roleId"
        },
        "reviewer": {
          "$ref": "#/$defs/roleId"
        },
        "gatekeeper": {
          "$ref": "#/$defs/roleId"
        },
        "gate": {
          "type": "string",
          "pattern": "^GATE-\\d{3}$"
        },
        "inputs": {
          "$ref": "#/$defs/strings"
        },
        "outputs": {
          "$ref": "#/$defs/strings"
        },
        "acceptance": {
          "$ref": "#/$defs/strings"
        },
        "stop": {
          "$ref": "#/$defs/strings"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "gate"
              }
            }
          },
          "then": {
            "required": [
              "decisions"
            ]
          }
        }
      ]
    },
    "optional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "deps",
        "before",
        "owner",
        "reviewer",
        "include_if",
        "stop"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "deps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "before": {
          "$ref": "#/$defs/nodeId"
        },
        "owner": {
          "$ref": "#/$defs/roleId"
        },
        "reviewer": {
          "$ref": "#/$defs/roleId"
        },
        "include_if": {
          "type": "string",
          "minLength": 10
        },
        "stop": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
