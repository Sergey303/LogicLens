{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/epistemic-compiler-lab/work-package.schema.json",
  "title": "Compile, Don't Teach work-package DAG",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "program",
    "hypotheses",
    "threat_controls",
    "change_control",
    "graph",
    "packages",
    "optional_robustness_work"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "repository",
        "branch",
        "working_area",
        "linear_project_id",
        "linear_issue_range",
        "snapshot_date",
        "central_claim_boundary",
        "non_claims"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "branch": {"type": "string", "minLength": 1},
        "working_area": {"type": "string", "pattern": "^EpistemicCompilerLab/"},
        "linear_project_id": {"type": "string", "format": "uuid"},
        "linear_issue_range": {"type": "string", "pattern": "^ENG-\\d+\\.\\.ENG-\\d+$"},
        "snapshot_date": {"type": "string", "format": "date"},
        "central_claim_boundary": {"type": "string", "minLength": 20},
        "non_claims": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "hypotheses": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "threat_controls": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "change_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "forbidden_changes_after_confirmatory_freeze",
        "required_invalidation_events"
      ],
      "properties": {
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forbidden_changes_after_confirmatory_freeze": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_invalidation_events": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_semantics",
        "roots",
        "terminal",
        "gate_sequence",
        "phase_order",
        "structural_critical_definition"
      ],
      "properties": {
        "edge_semantics": {"const": "dependency -> dependent"},
        "roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "terminal": {"$ref": "#/$defs/nodeId"},
        "gate_sequence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^GATE-\\d{3}$"}},
        "phase_order": {"type": "array", "const": ["W0", "W1", "W2", "W3", "W4"]},
        "structural_critical_definition": {"type": "string", "minLength": 20}
      }
    },
    "packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/package"}},
    "optional_robustness_work": {"type": "array", "items": {"$ref": "#/$defs/optionalWork"}}
  },
  "$defs": {
    "nodeId": {"type": "string", "pattern": "^(WP|GATE)-\\d{3}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "claimLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypotheses", "threat_controls"],
      "properties": {
        "hypotheses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^H[1-6]$"}},
        "threat_controls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "anyOf": [
        {"properties": {"hypotheses": {"minItems": 1}}},
        {"properties": {"threat_controls": {"minItems": 1}}}
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_role", "reviewer_role", "gatekeeper_role", "independence_rule"],
      "properties": {
        "producer_role": {"type": "string", "minLength": 1},
        "reviewer_role": {"type": "string", "minLength": 1},
        "gatekeeper_role": {"type": "string", "minLength": 1},
        "independence_rule": {"type": "string", "minLength": 20}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "linear_issue",
        "phase",
        "kind",
        "title",
        "mandatory",
        "structurally_critical",
        "dependencies",
        "ownership",
        "acceptance_gate",
        "inputs",
        "outputs",
        "acceptance_checks",
        "stop_or_pivot",
        "claim_links"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nodeId"},
        "linear_issue": {"type": "string", "pattern": "^ENG-\\d+$"},
        "phase": {"type": "string", "enum": ["W0", "W1", "W2", "W3", "W4"]},
        "kind": {"type": "string", "enum": ["work_package", "gate"]},
        "title": {"type": "string", "minLength": 1},
        "mandatory": {"const": true},
        "structurally_critical": {"type": "boolean"},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "ownership": {"$ref": "#/$defs/ownership"},
        "acceptance_gate": {"type": "string", "pattern": "^GATE-\\d{3}$"},
        "inputs": {"$ref": "#/$defs/nonEmptyStrings"},
        "outputs": {"$ref": "#/$defs/nonEmptyStrings"},
        "acceptance_checks": {"$ref": "#/$defs/nonEmptyStrings"},
        "stop_or_pivot": {"$ref": "#/$defs/nonEmptyStrings"},
        "claim_links": {"$ref": "#/$defs/claimLinks"},
        "decision_space": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "gate"}}},
          "then": {
            "required": ["decision_space"],
            "properties": {"id": {"type": "string", "pattern": "^GATE-\\d{3}$"}}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "work_package"}}},
          "then": {"properties": {"id": {"type": "string", "pattern": "^WP-\\d{3}$"}}}
        }
      ]
    },
    "optionalWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "mandatory",
        "dependencies",
        "must_finish_before",
        "owner_role",
        "reviewer_role",
        "claim_links",
        "include_only_if",
        "stop_rule"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^ROB-\\d{3}$"},
        "title": {"type": "string", "minLength": 1},
        "mandatory": {"const": false},
        "dependencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "must_finish_before": {"$ref": "#/$defs/nodeId"},
        "owner_role": {"type": "string", "minLength": 1},
        "reviewer_role": {"type": "string", "minLength": 1},
        "claim_links": {"$ref": "#/$defs/claimLinks"},
        "include_only_if": {"type": "string", "minLength": 10},
        "stop_rule": {"type": "string", "minLength": 10}
      }
    }
  }
}
