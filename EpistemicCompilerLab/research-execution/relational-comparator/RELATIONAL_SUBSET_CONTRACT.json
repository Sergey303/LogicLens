    "MIXED_SCOPE_OR_VERSION",
    "DEPENDENCY_SEMANTICS_REQUIRED",
    "MULTI_PREMISE_RULE",
    "NEGATIVE_PREMISE",
    "NEGATIVE_RULE_HEAD",
    "POLARITY_TRANSFORM",
    "PRIORITY_OR_EXCEPTION",
    "NEGATION_AS_FAILURE",
    "ARITHMETIC_PREDICATE",
    "PROVENANCE_NOT_LOSSLESS",
    "UNKNOWN_STRUCTURE"
