    "m16_proof_graph_visible": false,
    "m6_proof_frame_obligation_matched": false,
    "interpretation": "M16_vs_M6_is_trusted_result_interface_bundle_not_proof_equivalence"
  },
  "analysis": {
    "paired_eligible_scenarios_only": true,
