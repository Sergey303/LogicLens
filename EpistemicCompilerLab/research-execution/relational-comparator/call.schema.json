{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eng-197:relational-call:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["endpoint", "arguments"],
  "properties": {
    "endpoint": {"const": "resolve_claim"},
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposition_id", "scope_id", "version"],
      "properties": {
        "proposition_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "scope_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
