{
  "schema_version": "1.0.0",
  "work_package_id": "WP-006",
  "method": "paired_binary_normal_approximation_with_cluster_design_effect",
  "formula": {
    "paired_discordance": "q = p10 + p01",
    "effect": "delta = p10 - p01",
    "paired_difference_variance": "q - delta^2",
    "design_effect": "1 + (mean_cluster_size - 1) * icc",
    "effective_n": "eligible_n * (1 - attrition) / design_effect",
    "noncentrality": "abs(delta) * sqrt(effective_n / (q - delta^2))",
    "two_sided_power": "Phi(-z_alpha - noncentrality) + 1 - Phi(z_alpha - noncentrality)"
  },
