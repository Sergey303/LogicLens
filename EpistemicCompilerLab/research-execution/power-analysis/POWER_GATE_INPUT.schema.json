{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/wp006/power-gate-input.schema.json",
  "title": "WP-006 real power gate input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_package_id", "evidence_class", "r2_power", "dependency_resolution", "inventory", "blinded_update", "sealed_access"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "work_package_id": {"const": "WP-006"},
    "evidence_class": {"enum": ["REAL_LOCAL_GIT_RESOLUTION", "SYNTHETIC_TEST_FIXTURE"]},
    "r2_power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_path", "result_sha256", "producer_grid_floor", "type_I_gate_pass", "joint_power_gate_pass"],
      "properties": {
        "result_path": {"type": "string", "minLength": 1},
        "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "producer_grid_floor": {"type": "integer", "minimum": 820},
        "type_I_gate_pass": {"const": true},
        "joint_power_gate_pass": {"const": true}
      }
    },
    "dependency_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "all_required_dependencies_accepted"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "all_required_dependencies_accepted": {"type": "boolean"}
      }
    },
    "inventory": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "NOT_READY"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "eligible_base_scenario_ids", "independent_source_family_clusters", "eligible_inventory_sha256", "primary_treatment_arm_id", "primary_control_arm_id", "wp004_arm_binding_artifact_sha256", "wp005_scorer_artifact_sha256", "wp007_feasibility_artifact_sha256", "model_profile_assignment_frozen", "source_family_grouping_frozen"],
          "properties": {
            "status": {"const": "READY"},
            "eligible_base_scenario_ids": {"type": "integer", "minimum": 1},
            "independent_source_family_clusters": {"type": "integer", "minimum": 1},
            "eligible_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "primary_treatment_arm_id": {"type": "string", "minLength": 1},
            "primary_control_arm_id": {"type": "string", "minLength": 1},
            "wp004_arm_binding_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "wp005_scorer_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "wp007_feasibility_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "model_profile_assignment_frozen": {"const": true},
            "source_family_grouping_frozen": {"const": true}
          }
        }
      ]
    },
    "blinded_update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_eligible_n", "report_path", "report_sha256"],
      "properties": {
        "status": {"enum": ["NOT_USED", "USED"]},
        "required_eligible_n": {"type": "integer", "minimum": 820},
        "report_path": {"type": ["string", "null"]},
        "report_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sealed_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holdout_accessed", "replication_accessed"],
      "properties": {
        "holdout_accessed": {"const": false},
        "replication_accessed": {"const": false}
      }
    }
  }
}
