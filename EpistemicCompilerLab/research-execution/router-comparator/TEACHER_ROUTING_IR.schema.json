{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eng-200:teacher-routing-ir:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "root", "feature_contract", "capability_registry_version", "nodes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "root": {"type": "string", "minLength": 1},
    "capability_registry_version": {"const": "1.0.0"},
    "feature_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_class", "has_scope", "has_version", "asks_write", "requires_strict_policy"],
      "properties": {
        "goal_class": {"type": "array", "items": {"enum": ["claim_resolution", "provenance_lookup", "numeric_threshold", "explanation", "other"]}, "minItems": 5, "maxItems": 5, "uniqueItems": true},
        "has_scope": {"const": "boolean"},
        "has_version": {"const": "boolean"},
        "asks_write": {"const": "boolean"},
        "requires_strict_policy": {"const": "boolean"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "feature", "op", "value", "if_true", "if_false"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "condition"},
              "feature": {"enum": ["goal_class", "has_scope", "has_version", "asks_write", "requires_strict_policy"]},
              "op": {"const": "eq"},
              "value": {"type": ["string", "boolean"]},
              "if_true": {"type": "string", "minLength": 1},
              "if_false": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "capability_id", "capability_version"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "action"},
              "capability_id": {"type": "string", "minLength": 1},
              "capability_version": {"const": "1.0.0"}
            }
          }
        ]
      }
    }
  }
}
