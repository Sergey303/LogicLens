{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eng-200:teacher-routing-ir:v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "root",
    "feature_contract_id",
    "feature_contract_sha256",
    "capability_registry_version",
    "nodes"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "root": {"type": "string", "minLength": 1},
    "feature_contract_id": {"const": "eng200.routing-features.v1"},
    "feature_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capability_registry_version": {"const": "1.1.0"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "feature", "op", "value", "if_true", "if_false"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "condition"},
              "feature": {"enum": ["goal_class", "has_scope", "has_version", "asks_write", "requires_strict_policy"]},
              "op": {"const": "eq"},
              "value": {"type": ["string", "boolean"]},
              "if_true": {"type": "string", "minLength": 1},
              "if_false": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "capability_id", "capability_version"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "type": {"const": "action"},
              "capability_id": {"type": "string", "minLength": 1},
              "capability_version": {"const": "1.0.0"}
            }
          }
        ]
      }
    }
  }
}
