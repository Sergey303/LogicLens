{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/eng201/python-tool-api.schema.json",
  "title": "ENG-201 frozen Python tool API",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "program_version", "capabilities", "failure_codes", "limits"],
  "properties": {
    "contract_id": {"const": "eng201.python-api.v1"},
    "program_version": {"const": "0.1.0"},
    "failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["invalid_arguments", "contract_violation", "execution_error", "budget_exceeded"]}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_calls", "timeout_ms", "max_result_bytes"],
      "properties": {
        "max_calls": {"const": 1},
        "timeout_ms": {"const": 100},
        "max_result_bytes": {"const": 4096}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "schema_fragment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "additionalProperties", "required", "properties"],
      "properties": {
        "type": {"const": "object"},
        "additionalProperties": {"const": false},
        "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "properties": {"type": "object"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "name", "description", "arguments", "result", "provenance_required", "side_effects"],
      "properties": {
        "handle": {"enum": ["py_cap_01", "py_cap_02", "py_cap_03"]},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "arguments": {"$ref": "#/$defs/schema_fragment"},
        "result": {"$ref": "#/$defs/schema_fragment"},
        "provenance_required": {"const": true},
        "side_effects": {"const": "none"}
      }
    }
  }
}
