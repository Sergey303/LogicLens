{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/eng201/qwen-visible-python-request.schema.json",
  "title": "ENG-201 Qwen-visible Python interface before execution",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "question", "capabilities"],
  "properties": {
    "mode": {"enum": ["M21", "M22"]},
    "question": {"type": "string"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "name", "description", "arguments", "result"],
        "properties": {
          "handle": {"pattern": "^py_cap_[0-9]{2}$"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "arguments": {"type": "object"},
          "result": {"type": "object"}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "M21"}}}, "then": {"properties": {"capabilities": {"maxItems": 0}}}},
    {"if": {"properties": {"mode": {"const": "M22"}}}, "then": {"properties": {"capabilities": {"minItems": 3, "maxItems": 3}}}}
  ]
}
