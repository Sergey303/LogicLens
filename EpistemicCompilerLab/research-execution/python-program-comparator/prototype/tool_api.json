{
  "contract_id": "eng201.python-api.v1",
  "program_version": "0.1.0",
  "failure_codes": [
    "invalid_arguments",
    "contract_violation",
    "execution_error",
    "budget_exceeded"
  ],
  "limits": {
    "max_calls": 1,
    "timeout_ms": 100,
    "max_result_bytes": 4096,
    "max_memory_mb": 64
  },
  "capabilities": [
    {
      "handle": "py_cap_01",
      "name": "evidence_status",
      "description": "Combine explicit positive and negative evidence without treating absence as false.",
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "positive_evidence",
          "negative_evidence"
        ],
        "properties": {
          "positive_evidence": {"type": "boolean"},
          "negative_evidence": {"type": "boolean"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "value"],
        "properties": {
          "status": {"enum": ["supported", "refuted", "conflicting", "unknown"]},
          "value": {"type": ["boolean", "null"]}
        }
      },
      "provenance_required": true,
      "side_effects": "none"
    },
    {
      "handle": "py_cap_02",
      "name": "threshold_relation",
      "description": "Compare one numeric value with a threshold.",
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "threshold"],
        "properties": {
          "value": {"type": "number"},
          "threshold": {"type": "number"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "value"],
        "properties": {
          "status": {"const": "ok"},
          "value": {"enum": ["above", "below", "equal"]}
        }
      },
      "provenance_required": true,
      "side_effects": "none"
    },
    {
      "handle": "py_cap_03",
      "name": "interval_threshold",
      "description": "Determine whether an interval is wholly above, wholly below, or crosses a threshold.",
      "arguments": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lower", "upper", "threshold"],
        "properties": {
          "lower": {"type": "number"},
          "upper": {"type": "number"},
          "threshold": {"type": "number"}
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "value"],
        "properties": {
          "status": {"enum": ["supported", "refuted", "unknown"]},
          "value": {"enum": ["above", null]}
        }
      },
      "provenance_required": true,
      "side_effects": "none"
    }
  ]
}
