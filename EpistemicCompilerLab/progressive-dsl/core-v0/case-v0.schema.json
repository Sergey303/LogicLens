{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logiclens.local/contracts/synthetic-semantic-kernel-case-v0.schema.json",
  "title": "Synthetic Epistemic semantic-kernel case v0",
  "type": "object",
  "required": ["caseId", "kind"],
  "properties": {
    "caseId": {"type": "string", "minLength": 1},
    "kind": {
      "enum": ["strict-claim", "logical-rule", "numeric-comparison", "opinion-fusion"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "strict-claim"}}, "required": ["kind"]},
      "then": {"$ref": "#/$defs/strictClaim"}
    },
    {
      "if": {"properties": {"kind": {"const": "logical-rule"}}, "required": ["kind"]},
      "then": {"$ref": "#/$defs/logicalRule"}
    },
    {
      "if": {"properties": {"kind": {"const": "numeric-comparison"}}, "required": ["kind"]},
      "then": {"$ref": "#/$defs/numericComparison"}
    },
    {
      "if": {"properties": {"kind": {"const": "opinion-fusion"}}, "required": ["kind"]},
      "then": {"$ref": "#/$defs/opinionFusion"}
    }
  ],
  "$defs": {
    "provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "object",
      "required": ["evidenceId", "dependencyGroup", "provenance"],
      "properties": {
        "evidenceId": {"type": "string", "minLength": 1},
        "dependencyGroup": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "evidenceList": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "nonNegativeRational": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"}
      ]
    },
    "positiveRational": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^(?:[1-9][0-9]*)(?:/[1-9][0-9]*)?$"}
      ]
    },
    "unitIntervalDecimal": {
      "oneOf": [
        {"type": "integer", "enum": [0, 1]},
        {"type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"}
      ]
    },
    "decimal": {
      "oneOf": [
        {"type": "integer"},
        {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}
      ]
    },
    "unit": {
      "enum": ["fraction", "percent", "count", "millisecond", "second", "minute", "hour", "day"]
    },
    "strictClaim": {
      "type": "object",
      "required": ["caseId", "kind", "supportEvidence", "opposeEvidence"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "kind": {"const": "strict-claim"},
        "supportEvidence": {"$ref": "#/$defs/evidenceList"},
        "opposeEvidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "premise": {
      "type": "object",
      "required": ["premiseId", "supportEvidence", "opposeEvidence"],
      "properties": {
        "premiseId": {"type": "string", "minLength": 1},
        "supportEvidence": {"$ref": "#/$defs/evidenceList"},
        "opposeEvidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "logicalRule": {
      "type": "object",
      "required": ["caseId", "kind", "ruleId", "operator", "headStance", "premises"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "kind": {"const": "logical-rule"},
        "ruleId": {"type": "string", "minLength": 1},
        "operator": {"enum": ["all", "any"]},
        "headStance": {"enum": ["support", "oppose"]},
        "premises": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/premise"}
        }
      },
      "additionalProperties": false
    },
    "numericModel": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value", "unit"],
          "properties": {
            "kind": {"const": "point"},
            "value": {"$ref": "#/$defs/decimal"},
            "unit": {"$ref": "#/$defs/unit"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "lower", "upper", "unit"],
          "properties": {
            "kind": {"const": "bounded"},
            "lower": {"$ref": "#/$defs/decimal"},
            "upper": {"$ref": "#/$defs/decimal"},
            "unit": {"$ref": "#/$defs/unit"}
          },
          "additionalProperties": false
        }
      ]
    },
    "observation": {
      "type": "object",
      "required": ["observationId", "dependencyGroup", "provenance", "model"],
      "properties": {
        "observationId": {"type": "string", "minLength": 1},
        "dependencyGroup": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"},
        "model": {"$ref": "#/$defs/numericModel"}
      },
      "additionalProperties": false
    },
    "threshold": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": {"$ref": "#/$defs/decimal"},
        "unit": {"$ref": "#/$defs/unit"}
      },
      "additionalProperties": false
    },
    "numericComparison": {
      "type": "object",
      "required": ["caseId", "kind", "observation", "operator", "threshold"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "kind": {"const": "numeric-comparison"},
        "observation": {"$ref": "#/$defs/observation"},
        "operator": {"enum": [">=", "<=", ">", "<"]},
        "threshold": {"$ref": "#/$defs/threshold"}
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": ["reportId", "dependencyGroup", "positiveEvidence", "negativeEvidence", "baseRate", "provenance"],
      "properties": {
        "reportId": {"type": "string", "minLength": 1},
        "dependencyGroup": {"type": "string", "minLength": 1},
        "positiveEvidence": {"$ref": "#/$defs/nonNegativeRational"},
        "negativeEvidence": {"$ref": "#/$defs/nonNegativeRational"},
        "baseRate": {"$ref": "#/$defs/unitIntervalDecimal"},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "opinionFusion": {
      "type": "object",
      "required": ["caseId", "kind", "opinionSubjectLevel", "priorWeight", "reports"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "kind": {"const": "opinion-fusion"},
        "opinionSubjectLevel": {"enum": ["claim", "answer"]},
        "priorWeight": {"$ref": "#/$defs/positiveRational"},
        "reports": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/report"}
        }
      },
      "additionalProperties": false
    }
  }
}
