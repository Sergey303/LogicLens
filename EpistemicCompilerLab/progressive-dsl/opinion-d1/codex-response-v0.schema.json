{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSL-D1 Codex boundary response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "condition",
    "conclusion",
    "action",
    "withholdsAssertiveDecision",
    "belief",
    "disbelief",
    "uncertainty",
    "baseRate",
    "projectedProbability",
    "conflictIndex",
    "exactBelief",
    "exactDisbelief",
    "exactUncertainty",
    "exactBaseRate",
    "exactProjectedProbability",
    "exactConflictIndex",
    "usedScalar",
    "usedRoundedOpinion",
    "usedExactOpinion",
    "usedVerifiedFrame",
    "computedFromRounded",
    "computedFromExact",
    "recognizedRoundingCollision",
    "roundedInvariantPreserved",
    "exactInvariantPreserved",
    "baseRateIsPrior",
    "uncertaintyIsErrorProbability",
    "conflictSeparateFromUncertainty",
    "introducedFusion",
    "answerLevelProfile",
    "scopeStatement",
    "answer",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1"},
    "condition": {
      "type": "string",
      "enum": ["scalar", "rounded", "exact", "verified"]
    },
    "conclusion": {
      "type": "string",
      "enum": [
        "scalar_insufficient",
        "request_exact_opinion",
        "assert_with_evidence",
        "qualified_refutation",
        "qualify_prior_sensitive",
        "abstain_high_uncertainty",
        "report_conflict",
        "qualified_uncertain"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "abstain_on_scalar",
        "abstain_and_request_exact_opinion",
        "answer_with_epistemic_profile",
        "explain_refutation_with_profile",
        "answer_with_prior_warning",
        "abstain",
        "report_conflict",
        "answer_with_uncertainty"
      ]
    },
    "withholdsAssertiveDecision": {"type": "boolean"},
    "belief": {"type": "string"},
    "disbelief": {"type": "string"},
    "uncertainty": {"type": "string"},
    "baseRate": {"type": "string"},
    "projectedProbability": {"type": "string"},
    "conflictIndex": {"type": "string"},
    "exactBelief": {"type": "string"},
    "exactDisbelief": {"type": "string"},
    "exactUncertainty": {"type": "string"},
    "exactBaseRate": {"type": "string"},
    "exactProjectedProbability": {"type": "string"},
    "exactConflictIndex": {"type": "string"},
    "usedScalar": {"type": "boolean"},
    "usedRoundedOpinion": {"type": "boolean"},
    "usedExactOpinion": {"type": "boolean"},
    "usedVerifiedFrame": {"type": "boolean"},
    "computedFromRounded": {"type": "boolean"},
    "computedFromExact": {"type": "boolean"},
    "recognizedRoundingCollision": {"type": "boolean"},
    "roundedInvariantPreserved": {"type": "boolean"},
    "exactInvariantPreserved": {"type": "boolean"},
    "baseRateIsPrior": {"type": "boolean"},
    "uncertaintyIsErrorProbability": {"type": "boolean"},
    "conflictSeparateFromUncertainty": {"type": "boolean"},
    "introducedFusion": {"type": "boolean"},
    "answerLevelProfile": {"type": "boolean"},
    "scopeStatement": {"type": "string"},
    "answer": {"type": "string"},
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
