{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSL-D1 exact rational opinion fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "opinionId",
    "level",
    "sourceMode",
    "precision",
    "roundingMode",
    "exactOpinion",
    "exactConflictIndex",
    "roundedOpinion",
    "roundedConflictIndex",
    "scope",
    "provenance",
    "dependencyGroups"
  ],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "opinionId": {"type": "string"},
    "level": {"enum": ["claim", "answer"]},
    "sourceMode": {"enum": ["exact-rational", "rounded-only"]},
    "precision": {"type": "integer", "minimum": 0, "maximum": 12},
    "roundingMode": {"const": "half-even"},
    "exactOpinion": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/exactOpinion"}
      ]
    },
    "exactConflictIndex": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/fraction"}
      ]
    },
    "roundedOpinion": {"$ref": "#/$defs/roundedOpinion"},
    "roundedConflictIndex": {"type": "string"},
    "scope": {"type": "object"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "dependencyGroups": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "exactOpinion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["belief", "disbelief", "uncertainty", "baseRate"],
      "properties": {
        "belief": {"$ref": "#/$defs/fraction"},
        "disbelief": {"$ref": "#/$defs/fraction"},
        "uncertainty": {"$ref": "#/$defs/fraction"},
        "baseRate": {"$ref": "#/$defs/fraction"}
      }
    },
    "roundedOpinion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["belief", "disbelief", "uncertainty", "baseRate"],
      "properties": {
        "belief": {"type": "string"},
        "disbelief": {"type": "string"},
        "uncertainty": {"type": "string"},
        "baseRate": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "fragment", "title", "locator", "license"],
      "properties": {
        "sourceId": {"type": "string"},
        "fragment": {"type": "string"},
        "title": {"type": "string"},
        "locator": {"type": "string"},
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "status", "attribution"],
          "properties": {
            "id": {"type": "string"},
            "status": {"const": "internal"},
            "attribution": {"type": "string"}
          }
        }
      }
    }
  }
}
